//@version=6
indicator("RSI Entry Engine + EMA Filter + TF Presets [trade_w_samet]", shorttitle="RSI Entry + EMA + TF", overlay=false, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// ============================================================================
// TIMEFRAME PRESET SELECTOR
// ============================================================================
groupPreset = "🎛️ Timeframe Preset"

tfPreset = input.string("Auto (Chart TF)", "📅 Select Timeframe Preset",
     options=["Auto (Chart TF)", "1 Minute", "5 Minutes", "15 Minutes", "1 Hour", "4 Hours", "1 Day", "1 Week", "Custom (Manual)"],
     group=groupPreset,
     tooltip="Select a preset and all settings auto-adjust. Choose 'Custom (Manual)' for manual inputs.")

presetKey = switch tfPreset
    "1 Minute"        => "1m"
    "5 Minutes"       => "5m"
    "15 Minutes"      => "15m"
    "1 Hour"          => "1h"
    "4 Hours"         => "4h"
    "1 Day"           => "1d"
    "1 Week"          => "1w"
    "Custom (Manual)" => "custom"
    => "auto"

autoKey = timeframe.period == "1"   ? "1m"  :
          timeframe.period == "5"   ? "5m"  :
          timeframe.period == "15"  ? "15m" :
          timeframe.period == "60"  ? "1h"  :
          timeframe.period == "240" ? "4h"  :
          timeframe.period == "1D"  ? "1d"  :
          timeframe.period == "1W"  ? "1w"  : "4h"

activeKey = presetKey == "auto" ? autoKey : presetKey
usePreset = activeKey != "custom"

// Preset value functions
getPresetRsiLength(_k) =>
    _k == "1m" ? 7 : _k == "5m" ? 9 : _k == "15m" ? 10 : _k == "1w" ? 21 : 14

getPresetSmoothMode(_k) =>
    _k == "1w" ? "RMA" : "EMA"

getPresetSmoothLen(_k) =>
    _k == "1m" ? 3 : _k == "5m" ? 3 : _k == "15m" ? 3 : _k == "1w" ? 7 : 5

getPresetSignalLen(_k) =>
    _k == "1m" ? 5 : _k == "5m" ? 5 : _k == "15m" ? 7 : _k == "1w" ? 14 : 9

getPresetSignalMode(_k) =>
    _k == "1w" ? "RMA" : "EMA"

getPresetOverbought(_k) =>
    _k == "1m" ? 80 : _k == "5m" ? 75 : _k == "15m" ? 75 : 70

getPresetOversold(_k) =>
    _k == "1m" ? 20 : _k == "5m" ? 25 : _k == "15m" ? 25 : 30

getPresetExtremeHigh(_k) =>
    _k == "1m" ? 85 : _k == "5m" ? 80 : _k == "15m" ? 80 : _k == "1w" ? 80 : 75

getPresetExtremeLow(_k) =>
    _k == "1m" ? 15 : _k == "5m" ? 20 : _k == "15m" ? 20 : _k == "1w" ? 20 : 25

getPresetEmaLen(_k) =>
    _k == "1m" ? 50 : _k == "5m" ? 50 : _k == "15m" ? 100 : _k == "1h" ? 100 : 200

getPresetSlMode(_k) =>
    _k == "1w" ? "Signal Candle" : "ATR"

getPresetAtrLen(_k) => 14

getPresetAtrMult(_k) =>
    _k == "1m" ? 1.2 : _k == "5m" ? 1.3 : _k == "15m" ? 1.3 : _k == "1w" ? 2.0 : 1.5

getPresetRR(_k) =>
    _k == "1m" ? 1.5 : _k == "5m" ? 2.0 : _k == "15m" ? 2.0 : _k == "1h" ? 2.5 : _k == "1w" ? 4.0 : 3.0

// ============================================================================
// MANUAL OVERRIDE
// ============================================================================
groupManual = "🔧 Manual Override"
overrideManual = input.bool(false, "✏️ Enable Manual Override", group=groupManual,
     tooltip="Turn ON to manually set all values. Turn OFF to use preset auto-loading.")

// ============================================================================
// INPUTS (Manual)
// ============================================================================
groupRsi = "⚙️ RSI Engine"
rsiSource = input.source(close, "📌 RSI Source", group=groupRsi, display=display.none)
manualRsiLength = input.int(14, "📏 RSI Length", minval=1, group=groupRsi, display=display.none)
manualSmoothMode = input.string("EMA", "〰️ RSI Smoothing", options=["None", "EMA", "SMA", "RMA"], group=groupRsi, display=display.none)
manualSmoothLen = input.int(5, "🔧 Smoothing Length", minval=1, group=groupRsi, display=display.none)
manualSignalLen = input.int(9, "📐 Signal Length", minval=1, group=groupRsi, display=display.none)
manualSignalMode = input.string("EMA", "📡 Signal Smoothing", options=["EMA", "SMA", "RMA"], group=groupRsi, display=display.none)

groupLevels = "📊 RSI Levels"
manualOverbought = input.int(70, "🔴 Overbought", minval=50, maxval=100, group=groupLevels, display=display.none)
manualOversold = input.int(30, "🟢 Oversold", minval=0, maxval=50, group=groupLevels, display=display.none)
manualExtremeHigh = input.int(80, "🚨 Extreme High", minval=60, maxval=100, group=groupLevels, display=display.none)
manualExtremeLow = input.int(20, "✅ Extreme Low", minval=0, maxval=40, group=groupLevels, display=display.none)

groupEmaFilter = "📈 EMA Filter"
useEmaFilter = input.bool(true, "✅ Enable EMA Filter", group=groupEmaFilter, display=display.none)
manualEmaFilterLength = input.int(200, "📏 EMA Filter Length", minval=1, group=groupEmaFilter, display=display.none)
emaFilterSource = input.source(close, "📌 EMA Filter Source", group=groupEmaFilter, display=display.none)

groupTrade = "🎯 Trade Projection"
showTradeBoxes = input.bool(true, "📦 Show TP / SL Boxes On Main Chart", group=groupTrade, display=display.none)
entryMode = input.string("Close", "🎯 Entry Price", options=["Close", "Open", "HLC3"], group=groupTrade, display=display.none)
manualSlMode = input.string("ATR", "🛡️ Stop Loss Mode", options=["Signal Candle", "ATR", "Percent"], group=groupTrade, display=display.none)
manualRrTarget = input.float(3.0, "💎 Risk / Reward", minval=0.1, step=0.1, group=groupTrade, display=display.none)
manualAtrLen = input.int(14, "📏 ATR Length", minval=1, group=groupTrade, display=display.none)
manualAtrMult = input.float(1.5, "⚡ ATR Multiplier", minval=0.1, step=0.1, group=groupTrade, display=display.none)
percentSL = input.float(0.50, "📉 Percent Stop Loss", minval=0.01, step=0.01, group=groupTrade, display=display.none)
sameBarPriority = input.string("SL", "⚖️ Same-Bar TP / SL Priority", options=["SL", "TP"], group=groupTrade, display=display.none)
maxStoredTrades = input.int(20, "🗂️ Max Stored Trade Projections", minval=1, maxval=100, group=groupTrade, display=display.none)

groupVisual = "🎨 Visual Settings"
showBgExtreme = input.bool(true, "🌈 Highlight Extreme Background", group=groupVisual, display=display.none)
showPanel = input.bool(true, "📋 Show Status Panel", group=groupVisual, display=display.none)
panelPosition = input.string("Top Right", "📍 Panel Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupVisual, display=display.none)
panelTextSize = input.string("Small", "🔤 Panel Text Size", options=["Tiny", "Small", "Normal"], group=groupVisual, display=display.none)
labelTextSize = input.string("Normal", "🏷️ Label Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=groupVisual, display=display.none)
showEmaLine = input.bool(true, "📈 Show EMA Line On Main Chart", group=groupVisual, display=display.none)

groupAlerts = "🔔 Alerts"
enableCrossAlerts = input.bool(true, "🔁 RSI / Signal Cross Alerts", group=groupAlerts, display=display.none)
enableZoneAlerts = input.bool(true, "📊 Overbought / Oversold Reclaim Alerts", group=groupAlerts, display=display.none)
enableCenterAlerts = input.bool(true, "⚖️ Centerline Alerts", group=groupAlerts, display=display.none)
enableSignalAlerts = input.bool(true, "🚀 Entry Signal Alerts", group=groupAlerts, display=display.none)
enableTradeAlerts = input.bool(true, "🎯 TP / SL Hit Alerts", group=groupAlerts, display=display.none)

// ============================================================================
// FINAL ACTIVE VALUES (Preset OR Manual)
// ============================================================================
rsiLength       = (usePreset and not overrideManual) ? getPresetRsiLength(activeKey)      : manualRsiLength
smoothMode      = (usePreset and not overrideManual) ? getPresetSmoothMode(activeKey)     : manualSmoothMode
smoothLen       = (usePreset and not overrideManual) ? getPresetSmoothLen(activeKey)      : manualSmoothLen
signalLen       = (usePreset and not overrideManual) ? getPresetSignalLen(activeKey)      : manualSignalLen
signalMode      = (usePreset and not overrideManual) ? getPresetSignalMode(activeKey)     : manualSignalMode
overbought      = (usePreset and not overrideManual) ? getPresetOverbought(activeKey)     : manualOverbought
oversold        = (usePreset and not overrideManual) ? getPresetOversold(activeKey)       : manualOversold
extremeHigh     = (usePreset and not overrideManual) ? getPresetExtremeHigh(activeKey)    : manualExtremeHigh
extremeLow      = (usePreset and not overrideManual) ? getPresetExtremeLow(activeKey)     : manualExtremeLow
emaFilterLength = (usePreset and not overrideManual) ? getPresetEmaLen(activeKey)         : manualEmaFilterLength
slMode          = (usePreset and not overrideManual) ? getPresetSlMode(activeKey)         : manualSlMode
atrLen          = (usePreset and not overrideManual) ? getPresetAtrLen(activeKey)         : manualAtrLen
atrMult         = (usePreset and not overrideManual) ? getPresetAtrMult(activeKey)        : manualAtrMult
rrTarget        = (usePreset and not overrideManual) ? getPresetRR(activeKey)             : manualRrTarget

// ============================================================================
// COLORS
// ============================================================================
clrBg       = color.rgb(13, 17, 23)
clrHeader   = color.rgb(31, 41, 55)
clrBorder   = color.rgb(48, 54, 61)
clrText     = color.rgb(255, 255, 255)
clrMuted    = color.rgb(139, 148, 158)
clrBlue     = color.rgb(88, 166, 255)
clrGreen    = color.rgb(34, 197, 94)
clrRed      = color.rgb(239, 68, 68)
clrCardA    = color.rgb(22, 27, 34)
clrCardB    = color.rgb(18, 22, 28)
clrLineDark = color.rgb(20, 20, 20)

// ============================================================================
// HELPERS
// ============================================================================
getTablePosition(_pos) =>
    switch _pos
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

getTableTextSize(_size) =>
    switch _size
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

getLabelTextSize(_size) =>
    switch _size
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Large"  => size.large
        "Huge"   => size.huge
        => size.normal

ma(_src, _len, _mode) =>
    _mode == "EMA" ? ta.ema(_src, _len) :
     _mode == "SMA" ? ta.sma(_src, _len) :
     _mode == "RMA" ? ta.rma(_src, _len) :
     _src

getEntryPrice(_mode) =>
    _mode == "Open" ? open : _mode == "HLC3" ? hlc3 : close

formatPrice(_price) => str.tostring(_price, format.mintick)
formatRsi(_value) => str.tostring(_value, "#.##")

// ============================================================================
// GLOBAL VISUAL SETTINGS
// ============================================================================
chartLabelSize  = getLabelTextSize(labelTextSize)
labelTextFormat = text.format_bold + text.format_italic

txtUp    = "𝙐𝙋"
txtDown  = "𝘿𝙊𝙒𝙉"
txtBuy   = "𝘽𝙐𝙔"
txtSell  = "𝙎𝙀𝙇𝙇"
txtTpHit = "𝙏𝙋 𝙃𝙄𝙏"
txtSlHit = "𝙎𝙇 𝙃𝙄𝙏"

// ============================================================================
// EMA FILTER CALCULATION
// ============================================================================
emaFilter = ta.ema(emaFilterSource, emaFilterLength)
priceAboveEma = close > emaFilter
priceBelowEma = close < emaFilter

// ============================================================================
// RSI ENGINE
// ============================================================================
rsiRaw    = ta.rsi(rsiSource, rsiLength)
rsiSmooth = smoothMode == "None" ? rsiRaw : ma(rsiRaw, smoothLen, smoothMode)
signal    = ma(rsiSmooth, signalLen, signalMode)
spread    = rsiSmooth - signal
delta     = rsiSmooth - rsiSmooth[1]
atrValue  = ta.atr(atrLen)

isExtremeHigh = rsiSmooth >= extremeHigh
isOverbought  = rsiSmooth >= overbought
isBullish     = rsiSmooth > 50 and rsiSmooth < overbought
isNeutral     = rsiSmooth >= 45 and rsiSmooth <= 55
isBearish     = rsiSmooth < 50 and rsiSmooth > oversold
isOversold    = rsiSmooth <= oversold
isExtremeLow  = rsiSmooth <= extremeLow

rsiColor = isExtremeHigh ? clrRed : isExtremeLow ? clrGreen : clrBlue

// ============================================================================
// LEVELS (FIXED — plot() instead of hline() for dynamic values)
// ============================================================================
h100 = hline(100, "100", color=color.new(clrMuted, 100))
h0   = hline(0, "0", color=color.new(clrMuted, 100))
h50  = hline(50, "Center", color=color.new(clrMuted, 60), linestyle=hline.style_dotted)

plot(overbought,  "Overbought",   color=color.new(clrRed, 30),   linewidth=1, style=plot.style_circles)
plot(oversold,    "Oversold",     color=color.new(clrGreen, 30), linewidth=1, style=plot.style_circles)
plot(extremeHigh, "Extreme High", color=color.new(clrRed, 55),   linewidth=1, style=plot.style_cross)
plot(extremeLow,  "Extreme Low",  color=color.new(clrGreen, 55), linewidth=1, style=plot.style_cross)

bgcolor(rsiSmooth >= overbought ? color.new(clrRed, 88) : na, title="Overbought Zone Fill")
bgcolor(rsiSmooth <= oversold   ? color.new(clrGreen, 88) : na, title="Oversold Zone Fill")

bgcolor(showBgExtreme and isExtremeHigh ? color.new(clrRed, 80) : na)
bgcolor(showBgExtreme and isExtremeLow  ? color.new(clrGreen, 80) : na)

// ============================================================================
// RSI PLOT
// ============================================================================
plot(rsiSmooth, "RSI", color=rsiColor, linewidth=3)
plot(signal, "Signal", color=color.new(clrText, 35), linewidth=2)

// ============================================================================
// SIGNAL LOGIC WITH EMA FILTER
// ============================================================================
upSignalRaw   = ta.crossover(rsiSmooth, extremeLow) and barstate.isconfirmed
downSignalRaw = ta.crossunder(rsiSmooth, extremeHigh) and barstate.isconfirmed

upSignal   = useEmaFilter ? (upSignalRaw and priceAboveEma) : upSignalRaw
downSignal = useEmaFilter ? (downSignalRaw and priceBelowEma) : downSignalRaw

if upSignal
    label.new(bar_index, rsiSmooth, txtUp, xloc=xloc.bar_index, yloc=yloc.price,
         style=label.style_label_up, color=color.new(clrGreen, 0), textcolor=clrText,
         size=chartLabelSize, text_formatting=labelTextFormat,
         tooltip="RSI Extreme Low Reclaim\nPreset: " + tfPreset + "\nRSI: " + formatRsi(rsiSmooth) + "\nExtreme Low: " + str.tostring(extremeLow))

if downSignal
    label.new(bar_index, rsiSmooth, txtDown, xloc=xloc.bar_index, yloc=yloc.price,
         style=label.style_label_down, color=color.new(clrRed, 0), textcolor=clrText,
         size=chartLabelSize, text_formatting=labelTextFormat,
         tooltip="RSI Extreme High Rejection\nPreset: " + tfPreset + "\nRSI: " + formatRsi(rsiSmooth) + "\nExtreme High: " + str.tostring(extremeHigh))

// ============================================================================
// EMA PLOT ON MAIN CHART
// ============================================================================
plot(showEmaLine ? emaFilter : na, "EMA Filter", color=color.new(color.orange, 0), linewidth=2, force_overlay=true)

// ============================================================================
// TRADE STORAGE
// ============================================================================
var box[]   tpBoxes    = array.new_box()
var box[]   slBoxes    = array.new_box()
var line[]  entryLines = array.new_line()
var float[] entries    = array.new_float()
var float[] tps        = array.new_float()
var float[] sls        = array.new_float()
var int[]   dirs       = array.new_int()
var int[]   startBars  = array.new_int()
var bool[]  actives    = array.new_bool()

// ============================================================================
// TRADE CREATION
// ============================================================================
entryBase = getEntryPrice(entryMode)

if showTradeBoxes and upSignal
    longEntry = entryBase
    longSlRaw = slMode == "Signal Candle" ? low : slMode == "ATR" ? longEntry - atrValue * atrMult : longEntry * (1.0 - percentSL / 100.0)
    longSl    = math.min(longSlRaw, longEntry - syminfo.mintick)
    longRisk  = longEntry - longSl
    if longRisk > 0
        longTp = longEntry + longRisk * rrTarget
        tpBox = box.new(bar_index, longTp, bar_index + 1, longEntry, xloc=xloc.bar_index, border_color=color.new(clrGreen, 0), border_width=1, bgcolor=color.new(clrGreen, 65), force_overlay=true)
        slBox = box.new(bar_index, longEntry, bar_index + 1, longSl, xloc=xloc.bar_index, border_color=color.new(clrRed, 0), border_width=1, bgcolor=color.new(clrRed, 55), force_overlay=true)
        eLine = line.new(bar_index, longEntry, bar_index + 1, longEntry, xloc=xloc.bar_index, color=clrLineDark, width=2, force_overlay=true)
        label.new(bar_index, longEntry, txtBuy, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(clrGreen, 0), textcolor=clrText, size=chartLabelSize, force_overlay=true, text_formatting=labelTextFormat, tooltip="Long Trade\nPreset: " + tfPreset + "\nEntry: " + formatPrice(longEntry) + "\nSL: " + formatPrice(longSl) + "\nTP: " + formatPrice(longTp) + "\nRR: " + str.tostring(rrTarget, "#.##") + "R")
        array.push(tpBoxes, tpBox)
        array.push(slBoxes, slBox)
        array.push(entryLines, eLine)
        array.push(entries, longEntry)
        array.push(tps, longTp)
        array.push(sls, longSl)
        array.push(dirs, 1)
        array.push(startBars, bar_index)
        array.push(actives, true)

if showTradeBoxes and downSignal
    shortEntry = entryBase
    shortSlRaw = slMode == "Signal Candle" ? high : slMode == "ATR" ? shortEntry + atrValue * atrMult : shortEntry * (1.0 + percentSL / 100.0)
    shortSl    = math.max(shortSlRaw, shortEntry + syminfo.mintick)
    shortRisk  = shortSl - shortEntry
    if shortRisk > 0
        shortTp = shortEntry - shortRisk * rrTarget
        tpBox = box.new(bar_index, shortEntry, bar_index + 1, shortTp, xloc=xloc.bar_index, border_color=color.new(clrGreen, 0), border_width=1, bgcolor=color.new(clrGreen, 65), force_overlay=true)
        slBox = box.new(bar_index, shortSl, bar_index + 1, shortEntry, xloc=xloc.bar_index, border_color=color.new(clrRed, 0), border_width=1, bgcolor=color.new(clrRed, 55), force_overlay=true)
        eLine = line.new(bar_index, shortEntry, bar_index + 1, shortEntry, xloc=xloc.bar_index, color=clrLineDark, width=2, force_overlay=true)
        label.new(bar_index, shortEntry, txtSell, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(clrRed, 0), textcolor=clrText, size=chartLabelSize, force_overlay=true, text_formatting=labelTextFormat, tooltip="Short Trade\nPreset: " + tfPreset + "\nEntry: " + formatPrice(shortEntry) + "\nSL: " + formatPrice(shortSl) + "\nTP: " + formatPrice(shortTp) + "\nRR: " + str.tostring(rrTarget, "#.##") + "R")
        array.push(tpBoxes, tpBox)
        array.push(slBoxes, slBox)
        array.push(entryLines, eLine)
        array.push(entries, shortEntry)
        array.push(tps, shortTp)
        array.push(sls, shortSl)
        array.push(dirs, -1)
        array.push(startBars, bar_index)
        array.push(actives, true)

// Limit stored trades
while array.size(tpBoxes) > maxStoredTrades
    oldTpBox = array.shift(tpBoxes)
    oldSlBox = array.shift(slBoxes)
    oldELine = array.shift(entryLines)
    array.shift(entries)
    array.shift(tps)
    array.shift(sls)
    array.shift(dirs)
    array.shift(startBars)
    array.shift(actives)
    box.delete(oldTpBox)
    box.delete(oldSlBox)
    line.delete(oldELine)

// ============================================================================
// ACTIVE TRADE UPDATE
// ============================================================================
tradeCount = array.size(tpBoxes)
bool longTpHitBar  = false
bool longSlHitBar  = false
bool shortTpHitBar = false
bool shortSlHitBar = false

if tradeCount > 0
    for i = 0 to tradeCount - 1
        isActive = array.get(actives, i)
        if isActive
            tpBox    = array.get(tpBoxes, i)
            slBox    = array.get(slBoxes, i)
            eLine    = array.get(entryLines, i)
            tpPx     = array.get(tps, i)
            slPx     = array.get(sls, i)
            dir      = array.get(dirs, i)
            startBar = array.get(startBars, i)
            box.set_right(tpBox, bar_index)
            box.set_right(slBox, bar_index)
            line.set_x2(eLine, bar_index)
            tpHit = false
            slHit = false
            canCheck = bar_index > startBar
            if canCheck
                if dir == 1
                    tpHit := high >= tpPx
                    slHit := low <= slPx
                else
                    tpHit := low <= tpPx
                    slHit := high >= slPx
            if tpHit and slHit
                if sameBarPriority == "SL"
                    tpHit := false
                else
                    slHit := false
            if tpHit or slHit
                array.set(actives, i, false)
                if tpHit
                    if dir == 1
                        longTpHitBar := true
                    else
                        shortTpHitBar := true
                    label.new(bar_index, tpPx, txtTpHit, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(clrGreen, 0), textcolor=clrText, size=chartLabelSize, force_overlay=true, text_formatting=labelTextFormat, tooltip="TP Reached: " + formatPrice(tpPx))
                else
                    if dir == 1
                        longSlHitBar := true
                    else
                        shortSlHitBar := true
                    label.new(bar_index, slPx, txtSlHit, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(clrRed, 0), textcolor=clrText, size=chartLabelSize, force_overlay=true, text_formatting=labelTextFormat, tooltip="SL Reached: " + formatPrice(slPx))

// ============================================================================
// PANEL STATUS
// ============================================================================
statusText =
     isExtremeHigh ? "Extreme High" :
     isOverbought  ? "Overbought" :
     isBullish     ? "Bullish" :
     isNeutral     ? "Neutral" :
     isBearish     ? "Bearish" :
     isOversold    ? "Oversold" :
     "Extreme Low"

momentumText =
     delta >= 1.5  ? "Strong Up" :
     delta > 0     ? "Up" :
     delta <= -1.5 ? "Strong Down" :
     delta < 0     ? "Down" :
     "Flat"

crossState = spread > 0 ? "RSI > Signal" : spread < 0 ? "RSI < Signal" : "At Signal"
emaFilterState = useEmaFilter ? (priceAboveEma ? "Above EMA" : "Below EMA") : "Disabled"

panelPos  = getTablePosition(panelPosition)
panelSize = getTableTextSize(panelTextSize)

var table panel = table.new(panelPos, 2, 10, border_width=1, frame_color=clrBorder, border_color=clrBorder)

if barstate.islast
    if showPanel
        table.cell(panel, 0, 0, "𝙍𝙎𝙄 𝙋𝘼𝙉𝙀𝙇", text_color=clrText, text_size=panelSize, bgcolor=clrHeader, text_formatting=labelTextFormat)
        table.cell(panel, 1, 0, "𝙑𝘼𝙇𝙐𝙀", text_color=clrText, text_size=panelSize, bgcolor=clrHeader, text_formatting=labelTextFormat)
        table.cell(panel, 0, 1, "𝙏𝙞𝙢𝙚𝙛𝙧𝙖𝙢𝙚", text_color=clrText, text_size=panelSize, bgcolor=clrCardA, text_formatting=labelTextFormat)
